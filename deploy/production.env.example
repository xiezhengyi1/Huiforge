# Web security
RELAY_COOKIE_SECURE=1
HUIJU_ADMIN_USAGE_TOKEN=replace-with-a-long-random-token

# Durable operations analytics (must live outside versioned release folders)
HUIJU_EDGE_STATS_DB=/workspace/huiju-api/shared/data/edge-stats.sqlite3
HUIJU_ANALYTICS_BACKUP_DIR=/workspace/huiju-api/shared/data/analytics-backups
HUIJU_ANALYTICS_BACKUP_RETENTION_DAYS=120
HUIJU_ANALYTICS_BACKUP_INTERVAL_SECONDS=3600

# Runtime limits
RELAY_RATE_LIMIT_PER_MINUTE=30
QWEN_IMAGE_RATE_LIMIT_PER_MINUTE=10
RELAY_QUEUE_SIZE=8
RELAY_UPSTREAM_TIMEOUT_SECONDS=240

# Account registration (Volcengine SMS)
VOLC_SMS_ACCESS_KEY=
VOLC_SMS_SECRET_KEY=
VOLC_SMS_ACCOUNT=
VOLC_SMS_SIGN=
VOLC_SMS_TEMPLATE_ID=

# Email verification. Use a verified sender and an SMTP relay that supports TLS.
HUIJU_SMTP_HOST=
HUIJU_SMTP_PORT=587
HUIJU_SMTP_SECURITY=starttls
HUIJU_SMTP_FROM=
HUIJU_SMTP_USER=
HUIJU_SMTP_PASSWORD=
# Secret of at least 32 characters, identical across API workers.
HUIJU_EMAIL_CODE_SECRET=

# Image providers (configure at least one)
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Required when a cloud video model receives uploaded media. This must be the
# public HTTPS origin that proxies this app; providers fetch short-lived media
# URLs from it and cannot reach 127.0.0.1 or a private pod address.
HUIJU_PUBLIC_BASE_URL=https://your-domain
# Wan 3.0 uses the same endpoint by default; set this only when your workspace
# is configured for a dedicated Model Studio endpoint.
BAILIAN_WAN3_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_TTS_BASE_URL=
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=
GOOGLE_API_KEY=

# Video providers
FAL_KEY=
FAL_QUEUE_BASE_URL=https://queue.fal.run
ARK_VIDEO_API_KEY=
ARK_VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_2_0_MODEL=
SEEDANCE_2_0_MINI_MODEL=
SEEDANCE_2_0_FAST_MODEL=
SEEDANCE_2_5_MODEL=

# Audio providers
DOUBAO_SPEECH_API_KEY=
DOUBAO_SPEECH_BASE_URL=https://openspeech.bytedance.com
DOUBAO_SPEECH_RESOURCE_ID=seed-tts-2.0

# Optional short-drama agent
ARK_AGENT_API_KEY=
ARK_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_AGENT_MODEL=doubao-seed-2-0-lite-260428
